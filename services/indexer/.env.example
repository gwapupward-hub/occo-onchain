# OCCO Indexer — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp services/indexer/.env.example services/indexer/.env

# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────
PORT=3002
NODE_ENV=development

# ──────────────────────────────────────────────
# Database (PostgreSQL)
# Migrations run automatically on startup.
# ──────────────────────────────────────────────
DATABASE_URL=postgresql://occo:occo@localhost:5432/occo

# ──────────────────────────────────────────────
# Helius — Solana RPC + Webhook provider
# Sign up at https://dev.helius.xyz
# ──────────────────────────────────────────────
HELIUS_API_KEY=your_helius_api_key_here

# ──────────────────────────────────────────────
# Webhook Security
# A shared secret used to verify that incoming webhook
# requests are from Helius (HMAC-SHA256).
# Generate: openssl rand -hex 32
#
# In development this can be left empty — verification
# is skipped when NODE_ENV != production.
# ──────────────────────────────────────────────
WEBHOOK_SECRET=your_webhook_secret_here
