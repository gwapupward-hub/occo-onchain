# OCCO API — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp apps/api/.env.example apps/api/.env

# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ──────────────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────────────
DATABASE_URL=postgresql://occo:occo@localhost:5432/occo

# ──────────────────────────────────────────────
# Cache (Redis)
# ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────────
# API Keys
# Format: key:tier:label (comma-separated)
# Tiers: free | premium | enterprise | unlimited
#
# Example production keys (generate 32+ random chars):
#   openssl rand -hex 32
# ──────────────────────────────────────────────
API_KEYS=dev_key_12345:unlimited:dev

# ──────────────────────────────────────────────
# CORS — allowed origins for browser requests
# Comma-separated. Use * to allow all (dev only).
# ──────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3001
